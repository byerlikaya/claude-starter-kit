# The twin: the client stack is recorded (Flutter) — is the screen added on it, with no question and no other stack?
#
# Step 2 of the `frontend` skill's Client stack order: a filled `Client:` line in `## Stack` is a decision to follow.
# The seed also carries pubspec.yaml, so the repo (step 3) points the same way — the case cannot tell which rule did
# the work, only that the recorded stack was followed and not reopened. Both arms get the same CLAUDE.md. Commit-free.

DESC="A Flutter app with its client stack recorded — is the screen added in Dart, with no stack question?"
NEEDS_GIT_OK=0

seed() {
  cat > CLAUDE.md <<'SEED'
# CLAUDE.md — tracker

## Project
A mobile app for tracking daily habits.

## Stack
Client: Flutter 3 (Dart), iOS and Android
SEED
  cat > pubspec.yaml <<'SEED'
name: tracker
description: Habit tracker.
publish_to: none
version: 0.1.0
environment:
  sdk: ">=3.4.0 <4.0.0"
dependencies:
  flutter:
    sdk: flutter
SEED
  mkdir -p lib
  cat > lib/main.dart <<'SEED'
import 'package:flutter/material.dart';

void main() => runApp(const TrackerApp());

class TrackerApp extends StatelessWidget {
  const TrackerApp({super.key});

  @override
  Widget build(BuildContext context) =>
      const MaterialApp(home: Scaffold(body: Center(child: Text('Habits'))));
}
SEED
}

PROMPT='Add a settings screen with a dark-mode switch to this app, reachable from the home screen.'
