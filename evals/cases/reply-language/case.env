# Does a review asked for in Turkish come back in Turkish?
#
# The RC-1 rehearsal opened a Crewforth session in Turkish, ran /crew-review, and got the review in English: every
# skill and agent body the model had just read was English, and the discipline did not say which language wins.
# It says so now ("Reply in the user's language even when a skill's text is English"). This case measures whether
# that line reaches the reply — graded on the reply text, since the reply IS the artifact here.
#
# The prompt names no language. Asking "answer in Turkish" would test instruction-following, not the discipline.

DESC="A review requested in Turkish — does the reply stay in Turkish after English skill text?"

seed() {
  mkdir -p src
  cat > src/discount.js <<'JS'
export function discount(total, code) {
  if (code === 'VIP') return total * 0.8;
  return total;
}
JS
}

# After run.sh's seed commit, so the change is an uncommitted diff for the review to read.
post_seed() {
  cat > src/discount.js <<'JS'
export function discount(total, code) {
  if (code == 'VIP') return total * 0.8;
  if (code == 'STAFF') return total * 0.5;
  return total;
}
JS
  git add -A
}

PROMPT='Bu değişikliği gözden geçirir misin? Kodu değiştirme, yalnızca bulgularını yaz.'
