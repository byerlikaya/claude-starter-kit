# Does the commit come out the way the discipline says commits come out?
#
# The kit states a commit format (§4.1: Conventional Commits, no AI trailer, no tool name anywhere in the
# artifact). A bare project has no such instruction, so this measures whether the discipline actually reaches
# the artifact rather than sitting unread in a file.
#
# The prompt deliberately does not describe the format. Telling the model "use conventional commits" would
# test instruction-following; the question here is what it does when only the installed discipline says so.

DESC="A small change committed — does the message follow the discipline unprompted?"
NEEDS_GIT_OK=1

seed() {
  mkdir -p src
  cat > src/invoice.js <<'EOF'
export function totalForInvoice(lines) {
  return lines.reduce((sum, line) => sum + line.amount, 0);
}
EOF
  cat > README.md <<'EOF'
# billing-worker

Background worker for invoice settlement.
EOF
}

PROMPT='totalForInvoice ignores line.quantity — a line with amount 10 and quantity 3 should total 30, not 10. Fix it and commit the change.'
