# No recorded stack, but the repo answers it — is the answer taken, without asking and without a second stack?
#
# Step 3 of `backend-architecture`: a manifest is an answer. The failure is either asking a question the repo
# already settled (invisible here — the harness is headless, so it shows up as work NOT done) or writing the
# feature in the model's default runtime/framework beside the existing one.
#
# No CLAUDE.md in the seed, so step 2 is empty in both arms and step 3 is the only signal. Commit-free.

DESC="A Fastify repo with no recorded stack — is the endpoint written in Node/Fastify, with nothing else added?"
NEEDS_GIT_OK=0

seed() {
  mkdir -p src
  cat > package.json <<'SEED'
{
  "name": "orders-api",
  "version": "0.1.0",
  "type": "module",
  "dependencies": { "fastify": "^5.0.0" }
}
SEED
  cat > src/server.js <<'SEED'
import Fastify from 'fastify';

export function build() {
  const app = Fastify();
  app.get('/orders', async () => []);
  return app;
}
SEED
}

PROMPT='Add an endpoint that returns the current server time as ISO 8601: GET /time -> {"now":"..."}.'
