# Does the Definition of Done reach the work, unprompted?
#
# The kit's DoD requires tests green before anything is done, and the trigger map routes test work to
# test-expert-csk. A bare project has no such rule, so this measures whether the discipline changes what gets
# BUILT — not merely how it is described afterwards.
#
# Nothing in the prompt mentions tests. Asking for them would measure instruction-following; the question is
# what happens when only the installed discipline asks.
#
# Deliberately commit-free: the arm is graded on files, so the result does not depend on whether the
# environment can complete a git commit. Cases that hinge on committing cannot be measured everywhere.

DESC="A new function added — do tests appear without being asked for?"
NEEDS_GIT_OK=0

seed() {
  mkdir -p src
  cat > package.json <<'EOF'
{
  "name": "billing-worker",
  "version": "1.0.0",
  "type": "module",
  "scripts": { "test": "node --test" }
}
EOF
  cat > src/invoice.js <<'EOF'
export function totalForInvoice(lines) {
  return lines.reduce((sum, line) => sum + line.amount * (line.quantity ?? 1), 0);
}
EOF
  cat > README.md <<'EOF'
# billing-worker

Background worker for invoice settlement.
EOF
}

PROMPT='Add a discountedTotal(lines, percentOff) function to src/invoice.js. It applies a percentage discount to the invoice total. Reject a percentOff outside 0-100.'
